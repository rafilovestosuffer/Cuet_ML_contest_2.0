# Secrets & credentials
kaggle.json
.env
*.key

# Host dataset — proprietary, custom-combined by the contest organizers.
# Never commit any of it: raw CSVs, images, or the fold file (which embeds the
# host's captions + labels). Regenerate folds locally via `make folds`.
data/raw/
data/Train/
data/Test/
data/folds/
data/**/*.csv
*.jpg
*.jpeg
*.png
*.JPG
*.PNG

# Model weights & large frozen artifacts (distribute via Git LFS / GitHub Release)
*.pth
*.pt
*.ckpt
*.bin
*.safetensors
artifacts/*.npy

# Generated outputs — reproducible via `make figures` / `make reproduce`
results/figures/
results/tables/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/
dist/
build/
*.egg-info/
*.egg

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Claude Code local context (not part of the published repo)
CLAUDE.md
.claude/
